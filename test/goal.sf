# vardecl
a = 10
b = 20
c = 30

# func call
putln (a)
putln (b)
put (c)
put ('\n')

# constant condition
# AST removes the body
# in else
if 1
    putln ('1 is true')
else
    putln ('1 is false')

# constant condition (II)
# AST removes the body
# in if
if 0
    putln ('0 is true')
else
    putln ('0 is false')

# non-constant condition
# both if and else are
# preserved
if a
    putln ('a is true')
else
    putln ('a is false')

# comparison condition
if a == 10
    putln ('a is 10')
else
    putln ('a is anything but 10')

p = a == 10
q = a != 10
r = a < 10
s = a > 10
t = a <= 10
u = a >= 10

put ('p: ')
putln (p)
put ('q: ')
putln (q)
put ('r: ')
putln (r)
put ('s: ')
putln (s)
put ('t: ')
putln (t)
put ('u: ')
putln (u)

# while loop
# no while-else construct
i = 0
while i < 10
    put ('i: ')
    putln (i)

    i = i + 1

# nested while loop
i = 1
while i <= 10
    j = 0
    while j < i
        put ('*')
        j = j + 1
    put ('\n')
    i = i + 1

# func decl
fun makenum (a, b, c)
    # a, b and c are single digits
    putln (a * 100 + b * 10 + c)

# function call
makenum (9, 8, 1)

# recursion
fun fact (a)
    if a == 1
        return a
    return a * fact (a - 1)

i = 1
while i < 11
    putln (fact (i))
    i = i + 1

# tower of hanoi
fun toh (n, s, d, a)
    if n == 1
        put ('moving disk 1 from ')
        put (s)
        put (' to ')
        putln (d)
    else
        toh (n - 1, s, a, d)
        put ('moving disk ')
        put (n)
        put (' from ')
        put (s)
        put (' to ')
        putln (d)
        toh (n - 1, a, d, s)

toh (3, 'S', 'D', 'A')

# function with return
fun greet (name)
    return 'Hello and good afternoon ' + name

fun introduce_self (name, age)
    return 'Hello, my name is ' + name

putln (greet ('Shrehan'))

# class declaration
class Student
    name = 
    age = 

    fun _init (self, name, age)
        self.name = name
        self.age = age
    
    fun introduce (self)
        putln (introduce_self (self.name, self.age))
        

s = Student ('Shrehan', 19)
s.introduce ()
putln (s.name)
putln (s.age)

# for loop
for i in 1 to 10
    putln (i)

for i, j in [[1, 2], [3, 4], [5, 6]]
    put (i)
    put (', ')
    putln (j)

a = 1 to 10
putln (a)